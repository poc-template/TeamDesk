# 运行时配置示例（复制为 .env.local 后按需修改，切勿提交真实密钥）
# 数据库文件位置，默认 data/uobService.db
UOB_SERVICE_DB_PATH=./data/uobService.db
# 会话 Cookie 签名密钥：生产环境必须替换为随机字符串
UOB_SERVICE_SESSION_SECRET=please-change-me-in-production

# 远端 API 基础地址
# 通用地址（当某个服务未单独配置时回退到此地址）
API_BASE_URL=
# pbi 服务地址（待审查 pending-review 机能使用），可选，未配置时回退到 API_BASE_URL
API_BASE_URL_PBI=
# rob 服务地址（工单等机能使用），可选，未配置时回退到 API_BASE_URL
API_BASE_URL_ROB=
